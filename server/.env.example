# Ejemplo del .env del VPS (/srv/cuaderno/.env). El .env real no va al repositorio.
# VERSION no va acá: se pasa al levantar (`VERSION=x.y.z docker compose --env-file .env up -d`).

# Usuario y grupo con los que corre el contenedor (dueños de /srv/cuaderno/data y de adjuntos).
CUADERNO_UID=1000
CUADERNO_GID=1000

# Versión mínima de la app: una más vieja recibe "actualizá" (426).
APP_MIN_VERSION=0.2.0

# Vacío siempre. Solo para cambiar el pepper a propósito: 1, arrancar UNA vez y volver a dejarlo vacío.
# Con 1 borra las invitaciones sin usar y los intentos de unirse; si queda en 1, un cambio de pepper por error pasaría sin frenar.
ACEPTAR_PEPPER_NUEVO=
