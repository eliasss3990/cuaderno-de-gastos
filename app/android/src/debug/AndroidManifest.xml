<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la app de desarrollo: herramientas por adb (correr la tarea ya, crear/unirse/cargar sin pantallas) y
     HTTP sin cifrar solo hacia el servidor local (adb reverse). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/red_de_desarrollo">
        <receiver
            android:name=".SincronizarYa"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.eliasgonzalez.cuadernodegastos.SINCRONIZAR_YA" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".Desarrollo"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.eliasgonzalez.cuadernodegastos.DEV" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
